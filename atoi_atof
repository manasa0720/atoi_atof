  int my_atoi(const char*p)
  {
  int n=0,sign=1;
  while(*p==' '||*p=='\t'||*p=='"')
 p++;
  if(*p=='+'||*p=='-')
  {
  if(*p=='-')
  sign=-1;
  p++;
  }
  while(*p>='0'&&*p<='9')
  {
  n=n*10+(*p-'0');
  p++;
  }
  return n*sign;
  }
 
  float my_atof(const char*q)
  {
  float n=0,i=10;
  int sign=1;
  while(*q==' '||*q=='\t'||*q=='"')
  q++;
if(*q=='+'||*q=='-')
  {
  if(*q=='-')
  sign=-1;
  q++;
  }
  while(*q>='0'&&*q<='9')
  {
  n=n*10+(*q-'0');
  q++;
  }
  if(*q=='.')
  {
  q++;
  while(*q>='0'&&*q<='9')
  {
  n=n+(*q-'0')/i;
  i=i*10;
  q++;
  }
  }
  return n*sign;
  }
